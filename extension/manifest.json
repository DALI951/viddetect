{
  "manifest_version": 3,
  "name": "viddetect — YouTube Mix Sender",
  "version": "1.0",
  "description": "Automatically sends YouTube mix/playlist data to viddetect",
  "permissions": [],
  "host_permissions": [
    "http://localhost:3001/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
